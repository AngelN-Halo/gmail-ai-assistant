# --- Google OAuth (Gmail API) ---
# Create these in Google Cloud Console > APIs & Services > Credentials.
# See README.md for full step-by-step instructions.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the OAuth client.
GOOGLE_REDIRECT_URI=https://mail.example.com/api/auth/google/callback

# --- App / session ---
# Public base URL this app is served from. Used for OAuth redirects, same-origin
# checks, and to decide whether the session cookie is marked Secure.
# Use your real https:// origin in production.
APP_BASE_URL=https://mail.example.com
# Random string, at least 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET=

# --- Access control (REQUIRED) ---
# Comma-separated list of Gmail addresses permitted to sign in. Fail-closed:
# if this is empty, nobody can sign in. Without it, anyone who finds your URL
# could connect their own Gmail and spend your API quota and model compute.
ALLOWED_EMAILS=you@gmail.com

# --- Token encryption ---
# 64-char hex string (32 bytes) used to encrypt Gmail refresh tokens at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- AI backend (OpenAI-compatible /v1) ---
# Any server exposing /v1/chat/completions: llama.cpp, Ollama, vLLM, LM Studio.
AI_BASE_URL=http://127.0.0.1:8000/v1
AI_MODEL=unsloth/Qwen3.5-4B-GGUF
# Only if your model server requires an API key; leave blank otherwise.
AI_API_KEY=
# Request timeout in milliseconds.
AI_TIMEOUT_MS=90000
